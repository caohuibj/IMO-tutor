{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMO Tutor Problem",
  "type": "object",
  "required": ["problem_id", "schema_version", "status", "statement", "primary_domain", "difficulty_rating", "created_at"],
  "properties": {
    "problem_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "schema_version": {"const": 1},
    "workflow_version": {"type": "string"},
    "taxonomy_version": {"type": "integer"},
    "status": {"enum": ["NEW", "ANALYZED", "ATTEMPTING", "REVIEWED", "ARCHIVED"]},
    "source": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "statement": {"type": "string"},
    "primary_domain": {"enum": ["ALG", "CMB", "GEO", "NT"]},
    "secondary_domain": {"type": ["string", "null"]},
    "concept_tags": {"type": "array", "items": {"type": "string"}},
    "method_tags": {"type": "array", "items": {"type": "string"}},
    "difficulty_rating": {"type": "number", "minimum": 1, "maximum": 10, "multipleOf": 0.5},
    "difficulty_range": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "difficulty_basis": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "last_attempt_at": {"type": ["string", "null"]},
    "attempt_count": {"type": "integer", "minimum": 0},
    "latest_result_bucket": {"type": ["string", "null"]},
    "best_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
    "hint_max": {"type": ["string", "null"]},
    "mistake_tags": {"type": "array", "items": {"type": "string"}},
    "key_insight": {"type": ["string", "null"]},
    "search_text": {"type": "string"},
    "problem_image_url": {"type": ["string", "null"]},
    "note_url": {"type": ["string", "null"]},
    "folder_url": {"type": ["string", "null"]}
  }
}
